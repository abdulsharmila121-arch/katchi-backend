<!-- 🗳️ உங்கள் ஃபைலில் ஏற்கனவே இருக்கும் Dropdown-க்கு கீழே இதை அப்படியே வைக்கவும் -->
<div id="mlaInfoCard" class="card mt-3" style="display: none; max-width: 350px; margin: 15px auto; border: 1px solid #ddd; border-radius: 8px; padding: 15px; text-align: center; background-color: #f9f9f9;">
    <h5 style="color: #333; margin-bottom: 10px; font-size: 14px;">📌 உங்கள் தொகுதி சட்டமன்ற உறுப்பினர் (MLA)</h5>
    <!-- MLA புகைப்படம் காட்டும் இடம் -->
    <img id="mlaPhoto" src="" alt="MLA Photo" style="width: 140px; height: 170px; object-fit: cover; border-radius: 6px; box-shadow: 0px 4px 6px rgba(0,0,0,0.1); margin-bottom: 10px;">
    <!-- MLA பெயர் காட்டும் இடம் -->
    <h4 id="mlaName" style="color: #1a5f7a; font-weight: bold; font-size: 18px; margin: 5px 0;"></h4>
</div>
<script>
<!-- ⚡ தொகுதி மாறும் போது போட்டோவை மாற்றும் மேஜிக் ஸ்கிரிப்ட் (ஃபைலின் இறுதியில் வைக்கவும்) -->
document.addEventListener("DOMContentLoaded", function() {
    // HTML எலிமெண்ட்களை வேரியபிளில் எடுத்தல்
    const constituencySelect = document.getElementById('constituency');
    const mlaInfoCard = document.getElementById('mlaInfoCard');
    const mlaPhoto = document.getElementById('mlaPhoto');
    const mlaName = document.getElementById('mlaName');

    let mlaData = {};

    // 1. பேக்கெண்டில் இருந்து MLA லிஸ்ட்டை எடுத்து மெமரியில் வைக்கிறது
    fetch('/api/constituency-mlas')
        .then(response => response.json())
        .then(data => {
            mlaData = data;
        })
        .catch(err => console.error("Error fetching MLA data:", err));

    // 2. பயனர் தொகுதியை மாற்றும் போது (On Change) வேலை செய்யும்
    constituencySelect.addEventListener('change', function() {
        const selectedConstituency = this.value; // பயனர் தேர்ந்தெடுத்த தொகுதி (எ.கா: Vandavasi)

        // தேர்ந்தெடுத்த தொகுதிக்கு MLA டேட்டா இருந்தால்
        if (selectedConstituency && mlaData[selectedConstituency]) {
            mlaName.innerText = mlaData[selectedConstituency].name; // பெயரை மாற்றும்
            mlaPhoto.src = mlaData[selectedConstituency].photo;     // போட்டோவை மாற்றும்
            mlaInfoCard.style.display = 'block';                     // பாக்ஸை காட்டும்
        } else {
            mlaInfoCard.style.display = 'none';                      // எதுவும் செலக்ட் செய்யவில்லை எனில் மறைக்கும்
        }
    });
});
</script>