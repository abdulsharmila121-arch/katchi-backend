                                <td>5 Days</td>
                                <td><span style="background: #e74c3c; color: white; padding: 3px 8px; border-radius: 12px; font-weight: bold;">6.1 / 10</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="directiveSection" class="card toggle-section" style="margin-bottom: 25px; background: #fff8e1; border: 1px solid #ffe082;">
