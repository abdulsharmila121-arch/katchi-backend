                    <button type="button" style="background: #e74c3c; color: white; border: none; padding: 10px 15px; border-radius: 6px; cursor: pointer; font-weight: bold; display: flex; align-items: center; gap: 5px;">
                        🔴 Record Voice
                    </button>

                    <input type="text" name="directiveText" placeholder="அல்லது நேரடி உரையை டைப் செய்யவும்..." style="flex: 2; padding: 10px; border-radius: 6px; border: 1px solid #ccc;">

                    <button type="submit" style="background: #1e3c72; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold;">
                        🚀 Send Directive
                    </button>
                </form>
            </div>

            <div id="sentimentSection" class="card toggle-section" style="margin-bottom: 25px;">
                <h2 style="color: #1e3c72;">📊 Public Sentiment & Feedback Analysis (மக்களின் திருப்தி நிலை)</h2>
                
                <div style="display: flex; justify-style: space-around; align-items: center; margin-top: 15px; text-align: center; flex-wrap: wrap; gap: 15px;">
                    <div style="background: #e8f8f5; padding: 15px 25px; border-radius: 10px; min-width: 140px;">
                        <h2 style="color: #27ae60; margin: 0; border: none;">78%</h2>
                        <p style="margin: 5px 0 0; color: #2e7d32; font-weight: bold;">😊 நெகிழ்ச்சி / திருப்தி (Positive)</p>
                    </div>

                    <div style="background: #fef9e7; padding: 15px 25px; border-radius: 10px; min-width: 140px;">
                        <h2 style="color: #f39c12; margin: 0; border: none;">14%</h2>
                        <p style="margin: 5px 0 0; color: #d68910; font-weight: bold;">😐 நடுநிலை (Neutral)</p>
                    </div>

                    <div style="background: #fadbd8; padding: 15px 25px; border-radius: 10px; min-width: 140px;">
                        <h2 style="color: #c0392b; margin: 0; border: none;">8%</h2>
                        <p style="margin: 5px 0 0; color: #922b21; font-weight: bold;">☹️ குறைபாடுகள் (Negative)</p>
                    </div>
                </div>
            </div>

            <div id="cmMainTableSection" class="card">
                <h2>👑 முதலமைச்சர் மாநில அளவிலான குறைதீர்ப்பு கண்காணிப்பு போர்ட்டல்</h2>
                <div style="overflow-x:auto;">
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 25%;">மனு எண் & ஆவணங்கள்</th>
                                <th style="width: 20%;">தொகுதி & மனுதாரர்</th>
                                <th style="width: 25%;">புகார் விவரம் & வகை</th>
                                <th style="width: 30%;">பார்வர்ட் / நிலைமை மாற்றீடு</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% complaints.forEach(function(item) { %>
                                <tr>
                                    <td>
                                        <strong style="color:#b71c1c;"><%= item.grievanceId %></strong>
                                        
                                        <div class="attachment-buttons" style="margin-top: 10px; display: flex; gap: 6px; flex-wrap: wrap;">
                                            <% if (item.mediaFile) { %>
                                                <a href="/uploads/<%= item.mediaFile %>" target="_blank" class="status-btn" 
                                                   style="background-color: #007bff; color: white; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; padding: 5px 8px; font-size: 11px; border-radius: 4px;">
                                                    🖼️ View Media
                                                </a>
                                            <% } %>

                                            <% if (item.letterFile) { %>
                                                <a href="/uploads/<%= item.letterFile %>" target="_blank" class="status-btn" 
                                                   style="background-color: #28a745; color: white; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; padding: 5px 8px; font-size: 11px; border-radius: 4px;">
                                                    📄 View Letter
                                                </a>
                                            <% } %>
                                            
                                            <% if (!item.mediaFile && !item.letterFile) { %>
                                                <br><small style="color: #888; font-style: italic;">(No attachments)</small>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <strong><%= item.constituency %></strong><br>
                                        <small style="color:#555;"><%= item.citizenName %></small><br>
                                        <small style="color:#888;"><%= item.citizenMobile %></small>
                                    </td>
                                    <td>
                                        <small style="color: blue; font-weight: bold;"><%= item.grievanceCategory %></small>
                                        <p style="margin: 5px 0 0 0; color: #444; font-size: 13px; line-height: 1.4;"><%= item.description %></p>
                                    </td>
                                    <td>
                                        <form action="/update-status" method="POST" class="status-form">
                                            <input type="hidden" name="grievanceId" value="<%= item.grievanceId %>">
                                            
                                            <select name="forwardTo" class="status-select" style="margin-bottom: 5px;">
                                                <option value="">-- Forward To Officer --</option>
                                                <option value="MLA">MLA</option>
                                                <option value="Poruppalar">பொறுப்பாளர்</option>
                                                <option value="Collector">District Collector</option>
                                                <option value="DSP">DSP</option>
                                                <option value="Councilor">Councilor</option>
                                            </select>

                                            <select name="newStatus" class="status-select">
                                                <option value="Pending_Managaram" <%= item.status.startsWith('Pending') ? 'selected' : '' %>>Pending</option>
                                                <option value="In_Progress" <%= item.status === 'In_Progress' ? 'selected' : '' %>>In Progress</option>
                                                <option value="Completed" <%= item.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                                            </select>
                                            <button type="submit" class="status-btn">Update & Forward</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const hasSeen = localStorage.getItem('hasSeenThirukkural');
            const kuralModal = document.getElementById('kuralModal');

            if (kuralModal) {
                if (hasSeen === 'true') {
                    kuralModal.style.display = 'none';
                } else {
                    kuralModal.style.display = 'flex';
                }
            }
        });

        function closeKuralModal() {
            localStorage.setItem('hasSeenThirukkural', 'true');
            const modal = document.getElementById('kuralModal');
            if (modal) {
                modal.style.transition = 'opacity 0.3s ease';
                modal.style.opacity = '0';
                setTimeout(() => {
                    modal.style.display = 'none';
                }, 300);
            }
        }

        function handleLogout() {
            localStorage.removeItem('hasSeenThirukkural');
        }

        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            if (dropdown) dropdown.classList.toggle('show');
        }

        function requestPushPermission() {
            if ('Notification' in window) {
                Notification.requestPermission().then(permission => {
                    if (permission === 'granted') {
                        alert('✅ Web Push Notifications வெற்றிகரமாக ஆன் செய்யப்பட்டது!');
                        new Notification("தமிழ்நாடு மக்கள் குறைதீர்ப்பு போர்ட்டல்", {
                            body: "அறிவிப்புகள் வெற்றிகரமாக இணைக்கப்பட்டது!",
                            icon: "/favicon.ico"
                        });
                    } else {
                        alert('⚠️ நோட்டிபிகேஷன் அனுமதி மறுக்கப்பட்டது.');
                    }
                });
            } else {
                alert('மன்னிக்கவும், உங்கள் உலாவி (Browser) Push Notifications-ஐ ஆதரிக்கவில்லை.');
            }
        }

        function generateDynamicPDF(grievanceId, citizenName, officerRole, category) {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('landscape');

            doc.setDrawColor(30, 60, 114);
            doc.setLineWidth(5);
            doc.rect(10, 10, 277, 190);

            doc.setFont("helvetica", "bold");
            doc.setFontSize(22);
            doc.setTextColor(30, 60, 114);
            doc.text("GOVERNMENT OF TAMIL NADU", 140, 35, { align: "center" });

            doc.setFontSize(16);
            doc.setTextColor(183, 28, 28);
            doc.text("GRIEVANCE REDRESSAL SERVICE CERTIFICATE", 140, 50, { align: "center" });

            doc.setFontSize(12);
            doc.setTextColor(50, 50, 50);
            doc.setFont("helvetica", "normal");
            doc.text("This is to officially certify that the grievance registered under ID:", 140, 75, { align: "center" });

            doc.setFontSize(16);
            doc.setFont("helvetica", "bold");
            doc.text(grievanceId, 140, 90, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("helvetica", "normal");
            doc.text(`Submitted by Citizen: ${citizenName}`, 140, 105, { align: "center" });
            doc.text(`Category: ${category}`, 140, 115, { align: "center" });

            doc.setFont("helvetica", "italic");
            doc.text(`Has been successfully resolved on time by the designated authority (${officerRole}).`, 140, 130, { align: "center" });

            doc.setFont("helvetica", "bold");
            doc.setFontSize(11);
            doc.text("__________________________", 50, 170);
            doc.text("Member of Legislative Assembly (MLA)", 50, 178);

            doc.text("__________________________", 230, 170, { align: "right" });
            doc.text("Chief Minister Special Cell", 230, 178, { align: "right" });

            doc.save(`Certificate_${grievanceId}.pdf`);
        }

        function showMlaSection(sectionId) {
            const el = document.getElementById(sectionId);
            if(el) {
                el.style.display = (el.style.display === 'none' || el.style.display === '') ? 'block' : 'none';
            }
        }

        function downloadPDFReport() {
            const element = document.getElementById('poruppalarWorkTable');
            if(!element) return alert("டேபிள் தரவு இல்லை!");
            const options = {
                margin:       10,
                filename:     'Poruppalar_Work_Report.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };
            html2pdf().from(element).set(options).save();
        }

        function updateMLAProfile() {
    const selectedConstituency = document.getElementById('constituency').value;
    const card = document.getElementById("mla-profile-card");
    const mlaNameTag = document.getElementById("mla-name");
    const mlaImgTag = document.getElementById("mla-image");
    const fallbackTag = document.getElementById("mla-icon-fallback-new");

    // MLA விவரங்களுக்கான தரவுத் தொகுப்பு (Data Mapping)
    const mlaData = {
        "Anna Nagar": {
            name: "மாண்புமிகு எம்.கே. மோகன்",
            image: "/uploads/mla_anna_nagar.jpeg"
        },
        "Kolathur": {
            name: "மாண்புமிகு மு.க. ஸ்டாலின்",
            image: "/uploads/mla_kolathur.jpg"
        },
        "T. Nagar": {
            name: "மாண்புமிகு ஜெ. கருணாநிதி",
            image: "/uploads/mla_tnagar.jpg"
        }
    };

    if (selectedConstituency && mlaData[selectedConstituency]) {
        card.style.display = "block"; 
        mlaNameTag.innerText = mlaData[selectedConstituency].name;
        mlaImgTag.src = mlaData[selectedConstituency].image;
        mlaImgTag.style.display = 'block';
        if (fallbackTag) fallbackTag.style.display = 'none';
    } else {
        card.style.display = "none"; 
    }
}

        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if(sidebar && overlay) {
                sidebar.classList.toggle('active');
                overlay.classList.toggle('active');
            }
        }

        function toggleSection(sectionId) {
            const section = document.getElementById(sectionId);
            if (section) {
                if (section.style.display === "block") {
                    section.style.display = "none";
                } else {
                    document.querySelectorAll('.toggle-section').forEach(s => s.style.display = 'none');
                    section.style.display = "block";
                }
            }
        }

        function getCurrentLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(position => {
                    document.getElementById('googleMapLocation').value = position.coords.latitude + ", " + position.coords.longitude;
                    alert("📍 உங்கள் தற்போதைய இருப்பிடம் எடுக்கப்பட்டது!");
                });
            }
        }

        function startSpeechToText() {
            const voiceBtn = document.getElementById('voiceBtn');
            const descriptionBox = document.getElementById('complaintDescription');
            const langSelect = document.getElementById('voiceLangSelect');
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("மன்னிக்கவும், உங்கள் பிரவுசரில் வாய்ஸ் டைப்பிங் வசதி இல்லை!");
                return;
            }
            const recognition = new SpeechRecognition();
            recognition.lang = langSelect.value;
            recognition.interimResults = false;
            voiceBtn.innerHTML = "⏳ பேசலாம்...";
            voiceBtn.style.background = "#4caf50";
            recognition.start();

            recognition.onresult = function(event) {
                const result = event.results[0][0].transcript;
                descriptionBox.value += result + " ";
                descriptionBox.dispatchEvent(new Event('input')); 
            };
            recognition.onspeechend = function() {
                recognition.stop();
                voiceBtn.innerHTML = "🎙️ வாய்ஸ் டைப்பிங் (AI Voice)";
                voiceBtn.style.background = "#b71c1c";
            };
            recognition.onerror = function() {
                voiceBtn.innerHTML = "🎙️ வாய்ஸ் டைப்பிங் (AI Voice)";
                voiceBtn.style.background = "#b71c1c";
                alert("மீண்டும் முயற்சிக்கவும்!");
            };
        }

        function generatePoster(grievanceId, type) {
            const posterElement = document.getElementById(`poster-${type}-${grievanceId}`);
            if (!posterElement) {
                alert("போஸ்டர் விவரம் கிடைக்கவில்லை!");
                return;
            }
            html2canvas(posterElement, { scale: 2 }).then(canvas => {
                const link = document.createElement('a');
                link.download = `Poster_${type}_${grievanceId}.png`;
                link.href = canvas.toDataURL();
                link.click();
            });
        }
    </script>
    <script>
        const areaData = {
    "சென்னை": {
        "Anna Nagar": ["வார்டு 99", "வார்டு 100", "வார்டு 101", "வார்டு 102"],
        "Kolathur": ["வார்டு 64", "வார்டு 65", "வார்டு 66", "வார்டு 67"],
        "T. Nagar": ["வார்டு 113", "வார்டு 114", "வார்டு 115", "வார்டு 116"]
    }
};

function updateConstituencies() {
    const districtSelect = document.getElementById('district');
    const constituencySelect = document.getElementById('constituency');
    const wardSelect = document.getElementById('ward');
    
    // MLA கார்டை மறைக்க
    const mlaCard = document.getElementById("mla-profile-card");
    if (mlaCard) mlaCard.style.display = "none";

    const selectedDistrict = districtSelect.value;

    constituencySelect.innerHTML = '<option value="">தொகுதியைத் தேர்ந்தெடுக்கவும்</option>';
    wardSelect.innerHTML = '<option value="">முதலில் தொகுதியைத் தேர்ந்தெடுக்கவும்</option>';

    if (selectedDistrict && areaData[selectedDistrict]) {
        const constituencies = Object.keys(areaData[selectedDistrict]);
        constituencies.forEach(constituency => {
            const option = document.createElement('option');
            option.value = constituency;
            option.textContent = constituency;
            constituencySelect.appendChild(option);
        });
    }
}

// தொகுதி மாறியதும் வார்டுகளை அப்டேட் செய்ய
function updateWards() {
    const districtSelect = document.getElementById('district');
    const constituencySelect = document.getElementById('constituency');
    const wardSelect = document.getElementById('ward');

    const selectedDistrict = districtSelect.value;
    const selectedConstituency = constituencySelect.value;

    // Reset Ward Dropdown
    wardSelect.innerHTML = '<option value="">வார்டைத் தேர்ந்தெடுக்கவும்</option>';

    if (selectedDistrict && selectedConstituency && areaData[selectedDistrict][selectedConstituency]) {
        const wards = areaData[selectedDistrict][selectedConstituency];
        wards.forEach(ward => {
            const option = document.createElement('option');
            option.value = ward;
            option.textContent = ward;
            wardSelect.appendChild(option);
        });
    }
}

function autoSelectDepartment() {
    const description = document.getElementById('description').value.toLowerCase();
    const deptSelect = document.getElementById('department');

    // முக்கிய வார்த்தைகள் மற்றும் துறைகளின் பட்டியல்
    const keywords = {
        "மின்சாரம்": ["current", "eb", "electricity", "power", "light", "மின்சாரம்", "வயர்", "டிரான்ஸ்பார்மர்"],
        "குடிநீர் மற்றும் கழிவுநீர்": ["water", "drainage", "pipe", "leak", "தண்ணீர்", "குடிநீர்", "கழிவுநீர்", "சாக்கடை"],
        "சாலை மற்றும் போக்குவரத்து": ["road", "pothole", "street light", "traffic", "சாலை", "தெருவிளக்கு", "பழுது"],
        "சுகாதாரம் மற்றும் தூய்மை": ["garbage", "waste", "clean", "mosquito", "குப்பை", "கொசு", "சுகாதாரம்"]
    };

    for (let dept in keywords) {
        if (keywords[dept].some(word => description.includes(word))) {
            deptSelect.value = dept;
            break;
        }
    }
}

// இந்த ஃபங்ஷனை Dashboard Page Load ஆகும் போது இயக்க வேண்டும்
function checkUrgentComplaints(complaintsList) {
    // MLA பார்வர்ட் செய்த, இன்னும் முடிக்கப்படாத (Pending) 'Urgent' புகார்களை மட்டும் வடிகட்டுகிறது
    const urgentComplaints = complaintsList.filter(complaint => 
        complaint.priority === 'Urgent' && complaint.status !== 'Resolved'
    );

    const banner = document.getElementById('urgent-alert-banner');
    const countSpan = document.getElementById('urgent-count');

    if (urgentComplaints.length > 0) {
        countSpan.innerText = urgentComplaints.length;
        banner.style.display = 'block'; // Urgent புகார்கள் இருந்தால் Banner தெரியும்
    } else {
        banner.style.display = 'none';  // இல்லை என்றால் மறையும்
    }
}

// Banner-ஐ மூட விரும்பினால்
function dismissUrgentBanner() {
    document.getElementById('urgent-alert-banner').style.display = 'none';
}

// மாதிரித் தரவு (Sample Data - உங்கள் Backend/Database-ல் இருந்து வருவது)
const sampleComplaints = [
    { id: 101, title: "மின்சார வயர் துண்டிப்பு", priority: "Urgent", status: "Pending" },
    { id: 102, title: "குடிநீர் குழாய் பழுது", priority: "Normal", status: "Pending" },
    { id: 103, title: "சாக்கடை அடைப்பு", priority: "Urgent", status: "In Progress" }
];

// பக்கம் லோட் ஆனதும் ஃபங்ஷனை இயக்கவும்
document.addEventListener("DOMContentLoaded", function() {
    checkUrgentComplaints(sampleComplaints);
});
    </script>
