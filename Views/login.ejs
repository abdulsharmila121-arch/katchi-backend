        function checkGrievanceStatus() {
            const id = document.getElementById('trackGrievanceId').value.trim();
            if (!id) {
                alert('தயவுசெய்து மனு எண்ணை உள்ளிடவும்!');
                return;
            }

            const resultDiv = document.getElementById('statusResult');
            resultDiv.style.display = 'block';
            resultDiv.innerHTML = '<div style="text-align:center; color:#555;">🔄 தேடப்படுகிறது...</div>';

            fetch(`${window.location.origin}/api/quick-status/${encodeURIComponent(id)}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        resultDiv.innerHTML = `<span style="color: #dc3545; font-weight: bold;">❌ ${data.message}</span>`;
                        return;
                    }

                    const g = data.grievance;
                    let statusColor = g.status === 'Completed' ? '#28a745' : '#ffc107';
                    let statusText = g.status === 'Completed' ? '✓ பணி முடிந்தது' : '⚠️ நிலுவையில் உள்ளது';
                    
                    let html = `
