}

/* Scroll Container Window */
.notice-scroll-container {
    max-height: 400px; /* உங்களுக்கு ஏற்ற உயரத்தை வைக்கலாம் */
    overflow: hidden;  /* Scrollbar வெளியில் தெரியாமல் இருக்க */
    position: relative;
}

/* Moving Track with Gap */
.notice-list-track {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* Individual Notice Box Styling */
.notice-item {
    background-color: #f8fafc;
    border-left: 4px solid #94a3b8;
    padding: 18px 20px !important; /* கார்டுக்குள் இருக்கும் இடைவெளி */
    border-radius: 0 12px 12px 0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
    transition: all 0.2s ease-in-out;
}

.notice-item.urgent-notice {
    background-color: #fff5f5;
    border-left-color: #d90429;
}
