        }

        // On Page Load - Load saved language preference
        window.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('preferredAppLang') || 'ta';
            document.getElementById('appLangSelect').value = savedLang;
            toggleLanguage(savedLang);
        });
    </script>
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const track = document.getElementById('noticeTrack');
        // Duplicate notice items to make the loop seamless
        if (track) {
            track.innerHTML += track.innerHTML;
        }
    });
</script>
</body>
</html>
