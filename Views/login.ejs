<script>
document.addEventListener("DOMContentLoaded", function () {
    const container = document.querySelector('.notice-scroll-container');
    const track = document.querySelector('.notice-list-track');

    if (!container || !track) return;

    // 1. அறிவிப்புகளை தொடர்ச்சியாக சுழல வைக்க (Seamless Loop) Track-ஐ duplicate செய்கிறோம்
    track.innerHTML += track.innerHTML;

    let scrollSpeed = 0.8; // வேகம் (0.5 - மெதுவாக, 1.5 - வேகமாக)
    let animationId;
    let isHovered = false;

    function autoScroll() {
        if (!isHovered) {
            container.scrollTop += scrollSpeed;

            // பாதியை தாண்டியதும் மீண்டும் ஆரம்பத்திற்கு கொண்டு செல்வது (Infinite Loop Effect)
            if (container.scrollTop >= track.scrollHeight / 2) {
                container.scrollTop = 0;
            }
        }
        animationId = requestAnimationFrame(autoScroll);
    }

    // 2. Mouse கொண்டு போகும்போது Pause ஆகவும், வெளியில் எடுத்தால் Resume ஆகவும் செய்ய
    container.addEventListener('mouseenter', () => isHovered = true);
    container.addEventListener('mouseleave', () => isHovered = false);

    // Scrolling-ஐ தொடங்குகிறோம்
    autoScroll();
});
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const container = document.querySelector('.notice-scroll-container');
        const track = document.getElementById('noticeTrack');

        if (container && track) {
            // Smooth loop-க்காக கார்டுகளை 2 முறை டியூப்ளிகேட் செய்கிறோம்
            track.innerHTML += track.innerHTML;

            let scrollPos = 0;
            let isPaused = false;
            const speed = 0.8; // Scroll ஆகும் வேகம் (வேகத்தைக் குறைக்க 0.5 வைக்கலாம்)

            // Mouse வைக்கும்போது Pause ஆகும் Feature
            container.addEventListener('mouseenter', () => isPaused = true);
            container.addEventListener('mouseleave', () => isPaused = false);

            function autoScroll() {
                if (!isPaused) {
                    scrollPos += speed;
                    // பாதி தூரம் தாண்டியதும் சீராக ஆரம்பத்திற்குத் திரும்பும்
                    if (scrollPos >= track.scrollHeight / 2) {
                        scrollPos = 0;
                    }
                    container.scrollTop = scrollPos;
                }
                requestAnimationFrame(autoScroll);
            }

            autoScroll();
        }
    });
</script>

