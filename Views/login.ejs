                            <p style="margin: 5px 0;"><strong>துறை:</strong> ${g.department}</p>
                            <p style="margin: 5px 0;"><strong>நிலை:</strong> <span style="color: ${statusColor}; font-weight: bold;">${statusText}</span></p>
                        </div>`;
                    resultDiv.innerHTML = html;
                })
                .catch(err => {
                    resultDiv.innerHTML = '<span style="color: #dc3545;">❌ சர்வர் பிழை ஏற்பட்டது!</span>';
                });
        }

