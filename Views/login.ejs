    font-size: 15px;
}

/* RIGHT SIDE: Public Notice Board Styling */
.right-section {
    flex: 1; /* Takes remaining space seamlessly */
}

.notice-board-card {
    background-color: #ffffff;
    border-radius: 24px;
    padding: 24px;
    height: 480px; /* Matches Left Poster Height */
    box-sizing: border-box;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
    border-top: 6px solid #d90429;
    display: flex;
    flex-direction: column;
}

.notice-header {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 15px;
    margin-bottom: 15px;
}

.notice-header h2 {
    font-size: 20px;
    color: #0f172a;
    margin: 0;
    font-weight: 700;
}

.notice-icon {
    font-size: 24px;
}

.notice-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow-y: auto;
    padding-right: 5px;
    flex: 1;
}

.notice-item {
    background-color: #f8fafc;
    border-left: 4px solid #94a3b8;
    padding: 18px 20px !important; /* உள்ளே Text மூச்சுவிட நல்ல space தரும் */
    border-radius: 0 12px 12px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04); /* சின்ன 3D Look-க்காக */
    transition: all 0.2s ease-in-out;
}

.notice-item:hover {
    transform: translateX(4px);
    background-color: #f1f5f9;
}

.notice-item.urgent-notice {
    background-color: #fff5f5;
    border-left-color: #d90429;
}

.notice-date {
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
}

.notice-item h3 {
    margin: 3px 0 5px 0;
    font-size: 15px;
    color: #1e293b;
}

.notice-item p {
    margin: 0;
    font-size: 13px;
    color: #475569;
    line-height: 1.4;
}

/* Responsive Fix for Mobile */
@media (max-width: 850px) {
    .login-dashboard-container {
        flex-direction: column !important;
        align-items: center;
    }
    
    .left-section {
        width: 100%;
        max-width: 340px;
    }
    
    .right-section {
        width: 100%;
    }
}

.live-indicator {
    font-size: 11px;
    background-color: #fee2e2;
    color: #dc2626;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: bold;
