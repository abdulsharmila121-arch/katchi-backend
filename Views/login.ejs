    if (event.target == modal) {
        modal.style.display = "none";
    }
}

// தேடல் ஃபங்ஷன் (Live Search Filter)
function filterDepartments() {
    const input = document.getElementById("searchDepartment");
    const filter = input.value.toLowerCase();
    const table = document.getElementById("officersTable");
    const tr = table.getElementsByTagName("tr");

    for (let i = 1; i < tr.length; i++) {
        let textContent = tr[i].textContent || tr[i].innerText;
        if (textContent.toLowerCase().indexOf(filter) > -1) {
            tr[i].style.display = "";
        } else {
            tr[i].style.display = "none";
        }
    }
}

async function searchQuickStatus() {
    const inputField = document.getElementById('quickGrievanceId');
    const resultContainer = document.getElementById('quickStatusResult');
    
    if (!inputField || !resultContainer) {
        alert("HTML Elements கிடைக்கவில்லை! ID-களை சரிபார்க்கவும்.");
        return;
    }

    const grievanceId = inputField.value.trim();

    if (!grievanceId) {
        resultContainer.innerHTML = `<div style="color: red; padding: 10px;">⚠️ தயவுசெய்து மனு எண்ணை உள்ளிடவும்!</div>`;
        return;
    }

    resultContainer.innerHTML = `<div style="color: blue; padding: 10px;">⏳ தேடப்படுகிறது...</div>`;

    try {
        const response = await fetch(`/api/check-status?grievanceId=${encodeURIComponent(grievanceId)}`);
        const data = await response.json();

        if (data.success) {
            const c = data.complaint;
            resultContainer.innerHTML = `
                <div style="background: #e8f5e9; border: 1px solid #4caf50; padding: 15px; border-radius: 8px; text-align: left; margin-top: 10px; color: #333;">
                    <h4 style="margin: 0 0 8px 0; color: #2e7d32;">✅ மனு விவரம்:</h4>
                    <p style="margin: 4px 0;"><b>மனு எண்:</b> ${c.grievanceId}</p>
                    <p style="margin: 4px 0;"><b>பெயர்:</b> ${c.citizenName}</p>
                    <p style="margin: 4px 0;"><b>வகை:</b> ${c.grievanceCategory}</p>
                    <p style="margin: 4px 0;"><b>தற்போதைய நிலை:</b> <span style="background:#2196F3; color:white; padding:2px 8px; border-radius:10px; font-size:12px;">${c.status}</span></p>
                    ${c.isArchived ? '<p style="color: #d32f2f; margin: 4px 0;"><b>குறிப்பு:</b> இந்த மனு காப்பகப்படுத்தப்பட்டுள்ளது (Archived).</p>' : ''}
                </div>
            `;
        } else {
            resultContainer.innerHTML = `<div style="color: red; background: #ffebee; padding: 10px; border-radius: 6px; margin-top: 10px;">❌ ${data.message}</div>`;
        }
    } catch (err) {
        console.error('Fetch Error:', err);
        resultContainer.innerHTML = `<div style="color: red; background: #ffebee; padding: 10px; border-radius: 6px; margin-top: 10px;">❌ சர்வருடன் இணைக்க முடியவில்லை!</div>`;
    }
}
</script>

